# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/

# R
.Rproj.user
.Rhistory
.RData
.Ruserdata

# UDPipe models (large binary, download per README instructions)
models/

# Experiment pipeline intermediates (large pickles, regenerated by pipeline)
experiment_01/outputs/*.pkl
experiment_01/outputs/feature_matrix.csv
experiment_02/outputs/*.pkl
experiment_02/outputs/dissent_feature_matrix.csv
experiment_02/outputs/decision_feature_matrix.csv

# Env files with secrets / machine-specific overrides (API keys etc.)
.env
**/.env

# experiment_02 ad-hoc prompt experiment: sample texts are data (keep prompt.txt)
experiment_02/data/text_*.txt

# Scraped data (large, regenerated by scrapers; keep code, ignore output)
scrapers/data/
scrapers/nalus_v2/data/
scrapers/**/progress.json
scrapers/**/summary.json

# Annotation input/output (generated from scraped data; shared via fileshare)
experiment_03/decisions_to_annotate/
experiment_03/annotated/

# LLM annotation pipeline data (generated from scraped data)
experiment_03/data/

# experiment_03 analysis intermediates/results (regenerated by the pipeline)
experiment_03/outputs/*.pkl
experiment_03/outputs/*_feature_matrix.csv
experiment_03/models/

# Per-decision cards: 308 bulky, regenerable PNGs (~25MB) shared via the zip.
# Keep only the two featured in the report so it renders on GitHub.
experiment_03/outputs/cards/*
!experiment_03/outputs/cards/2-101-95.png
!experiment_03/outputs/cards/3-1909-22_1.png

# Factgenie campaign runtime data (generated; keep code + .gitkeep only)
annotations/campaigns/*/

# Local archives / data snapshots (reversibility backups, not versioned)
.archive/

# IDE
.idea/
.vscode/
*.swp
*.swo

# LibreOffice / Office lock files
.~lock.*#
